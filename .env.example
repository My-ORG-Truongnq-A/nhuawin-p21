# Mẫu biến môi trường (KT-11). Chỉ tên biến + placeholder, KHÔNG để giá trị thật.
# Người vận hành nhập giá trị thật trên Vercel; agent không nhận token.

# --- Host / index (SEO-01, SEO-02) ---
# Host cuối trả 200, không có "/" cuối. Domain tạm *.vercel.app luôn noindex.
NEXT_PUBLIC_SITE_URL=https://example.vercel.app
# "1" (hoặc "true") mới cho index, và chỉ khi VERCEL_ENV=production + host không phải *.vercel.app.
ALLOW_INDEXING=0

# --- Nguồn nội dung (KT-01) ---
# seed = đọc dữ liệu mẫu cục bộ, không gọi Sanity (test / CI / build cục bộ). Bỏ trống = Sanity nếu có projectId.
SANITY_SOURCE=seed

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# --- Lead (LD-*) ---
LEAD_DESTINATION=digiagent_crm
DGA_API_URL=
DGA_FORM_KEY=
LEAD_TO_EMAIL=
LEADS_DRY_RUN=1

# --- Tracking / widget (để trống thì không nhúng script) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_CHAT_WIDGET_KEY=

# --- Cron ---
CRON_SECRET=
